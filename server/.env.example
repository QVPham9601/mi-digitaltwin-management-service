# Server Configuration
NODE_ENV=development
PORT=3000

# Database - Local MongoDB
MONGODB_URI=mongodb://localhost:27017/intact

# Database - MongoDB Atlas (uncomment and configure for cloud deployment)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/intact?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin User (for seeding)
ADMIN_USERNAME=admin
# REQUIRED — no default. Known defaults (intact2025, admin, password) are
# refused by seeding; example values are flagged as startup errors in production.
ADMIN_PASSWORD=change-me-strong-admin-password

# Credential encryption key
# REQUIRED — no default. Minimum 16 characters; the value is SHA-256 derived
# into the AES-256 key, so any length at or above the floor works.
# Generate with: openssl rand -hex 16. Default/example values are rejected by
# the startup checks in every NODE_ENV.
# Never rotate after the first deploy: stored credentials become undecryptable.
ENCRYPTION_KEY=change-me-strong-encryption-key

# Branding profile: default | intact | secassured
BRANDING_PROFILE=secassured

# Boss Agent / RAG (local LLM via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_PREDICT=384
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2

# Vector storage backend
VECTOR_DB_TYPE=mongodb

# Observability (all optional)
# Prometheus metrics at GET /metrics (default true). Set METRICS_TOKEN (16+
# chars) to require `Authorization: Bearer <token>` on scrapes when the
# server is reachable from outside the cluster.
METRICS_ENABLED=true
# METRICS_TOKEN= # gitleaks:allow — placeholder, unset by default
# OpenTelemetry tracing starts only when this is set (OTLP/HTTP endpoint of
# the collector, e.g. http://otel-collector:4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=secsim-server

# Chat generator for the Boss Agent (embeddings always stay on Ollama):
#   CHAT_PROVIDER=ollama     -> OLLAMA_MODEL on OLLAMA_BASE_URL (default)
#   CHAT_PROVIDER=openai     -> any OpenAI-compatible server (CHAT_BASE_URL, CHAT_API_KEY)
#   CHAT_PROVIDER=anthropic  -> the Claude API (ANTHROPIC_API_KEY), e.g. CHAT_MODEL=claude-opus-5-5
# CHAT_PROVIDER=ollama
# CHAT_MODEL=
# ANTHROPIC_API_KEY=
# CHAT_EFFORT=medium
# CHAT_ANTHROPIC_FALLBACK=true
